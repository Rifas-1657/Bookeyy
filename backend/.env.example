# =============================================================================
# Bookey Backend Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All settings have safe defaults for development; production requires changes.

# --- App Environment ---
# Options: development, testing, production
APP_ENV=development
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
# SQLite for development (default), PostgreSQL for production
# Examples:
#   Development: sqlite+aiosqlite:///./bookey_dev.db
#   Production: postgresql+asyncpg://user:pass@host:5432/bookey
DATABASE_URL=sqlite+aiosqlite:///./bookey_dev.db
# PostgreSQL: the schema is owned by Alembic -> run `alembic upgrade head` (startup never
# runs create_all there). Local Postgres without Docker: python scripts/dev_postgres.py start
# Behind PgBouncer transaction mode (Supabase pooler :6543) set DB_PGBOUNCER=true.
DB_PGBOUNCER=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Durable job queue (course / book builds, app/jobs) ---
# Worker inside the API process; set false when running `python -m app.worker` separately.
JOBS_INLINE_WORKER=true
JOBS_CONCURRENCY=2
# A claimed job is requeued (resumed elsewhere) if its lease is not renewed in time.
JOBS_LEASE_SECONDS=60
JOBS_POLL_INTERVAL=1
# Attempts before a job ends `failed` (retry delay = base * 2^(attempt-1), capped)
JOBS_MAX_ATTEMPTS=3
JOBS_BACKOFF_BASE_SECONDS=10
JOBS_BACKOFF_MAX_SECONDS=600
DB_ECHO=false

# --- Auth & Security ---
# CRITICAL: Set a strong random SECRET_KEY in production!
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Production refuses to start with a short (<32 chars) or default key.
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Development admin password (only used if BOOKEY_ADMIN_DEV_PASSWORD is set)
# If not set in development, a random password will be generated and printed
# Production deployments must NOT use this and should never seed a default admin
BOOKEY_ADMIN_DEV_PASSWORD=

# --- CORS ---
# Comma-separated list of allowed origins
# MUST NOT contain localhost in production!
CORS_ORIGINS=http://localhost:3000,http://localhost:4100,http://127.0.0.1:3000

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL=30
WS_HEARTBEAT_TIMEOUT=10
WS_MAX_MESSAGE_SIZE=524288
WS_AUTH_TIMEOUT=5.0
# Per-session voice-question (audio_in) buffer caps
WS_MAX_AUDIO_BYTES=10485760
WS_MAX_AUDIO_SECONDS=60
# Also pass the frame cap to the server: uvicorn app.main:app --ws-max-size 524288

# --- Protocol ---
BOOK_PROTOCOL_VERSION=2

# --- MockBookService Timing (milliseconds) ---
MOCK_TOKEN_MS=85
MOCK_THINKING_MS=600
MOCK_ANSWER_TOKEN_MS=45
MOCK_CODE_STREAM_MS=30

# --- Rate Limiting ---
# Default limit on every route; keyed by user id (valid JWT) else client IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
# /auth/login, /auth/signup, /auth/password-reset/*
RATE_LIMIT_AUTH_PER_MINUTE=10
# POST /api/books
RATE_LIMIT_BOOKS_PER_MINUTE=10
# /api/voice/tts + /api/voice/stt (per user)
RATE_LIMIT_VOICE_PER_MINUTE=30
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For (empty = never trusted)
TRUSTED_PROXIES=

# --- Upload body limits (rejected early from Content-Length / streamed byte count) ---
MAX_UPLOAD_BODY_BYTES=31457280
MAX_ADMIN_UPLOAD_BODY_BYTES=209715200
MAX_STT_UPLOAD_BYTES=10485760

# --- SMTP (Email) ---
# Required for password reset in production
# TODO: SMTP delivery of reset tokens is not implemented yet; tokens are never logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@bookey.app

# =============================================================================
# B2: Knowledge Base
# =============================================================================

# --- Document Processing ---
MAX_DOCUMENT_SIZE_BYTES=26214400  # 25 MB
# PDF parsing caps
PDF_MAX_PAGES=300
PDF_MAX_OCR_PAGES=30
# DOCX/PPTX zip-bomb guard
ZIP_MAX_TOTAL_UNCOMPRESSED_BYTES=209715200
ZIP_MAX_ENTRIES=5000
ZIP_MAX_COMPRESSION_RATIO=100

# --- Storage ---
# Options: local, s3, supabase
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./uploads

# S3-compatible storage (when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_ENDPOINT_URL=

# Supabase Storage over REST (when STORAGE_BACKEND=supabase): private bucket, service_role/sb_secret key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bookey

# --- Embeddings ---
# Options: mock, fastembed (ONNX on CPU, production), bge_m3 (torch), api
EMBEDDING_BACKEND=mock
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=auto
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_THREADS=1

# --- Vector Store ---
# Options: chroma (dev), pgvector (PostgreSQL, migration 0009)
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./chroma_db

# --- Retrieval ---
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.0
RETRIEVAL_MMR_LAMBDA=0.7

# =============================================================================
# B3: LLM Router & Page Generator
# =============================================================================

# --- LLM Providers ---
# Comma-separated list, tried in order: gemini,groq,openrouter
# 'mock' (placeholder output) is IGNORED unless APP_ENV=testing or LLM_ALLOW_MOCK=true,
# and production refuses to start with it configured.
LLM_PROVIDERS=groq,openrouter,gemini
LLM_ALLOW_MOCK=false
LLM_RETRY_PER_PROVIDER=2
LLM_BACKOFF_BASE_S=1.0
# Overall wall-clock budget for one LLM call across all providers + retries (seconds)
LLM_CALL_DEADLINE_S=90

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- Page Generator ---
PAGE_MIN_WORDS=60
PAGE_MAX_WORDS=300
PAGE_MAX_TOKENS=8192
PAGE_GEN_MAX_REPAIR_ATTEMPTS=2
# Execute LLM-written Python code blocks to verify expected_output. Default false:
# code is only syntax-checked. The built-in runner is NOT a security boundary — only
# enable inside real isolation (container without network / nsjail / gVisor).
# Learner-created books never execute code regardless of this flag.
CODE_RUNNER_ENABLED=false

# =============================================================================
# B4: Tutor Agent
# =============================================================================

TUTOR_HISTORY_WINDOW=3
TUTOR_MAX_ANSWER_TOKENS=800

# =============================================================================
# B5: Voice (STT + TTS)
# =============================================================================

# --- Voice Providers ---
# TTS_PROVIDER=local (default) → FREE, local, female voices:
#   Tanglish: transliterate to Tamil script → pocket_tts (Geetha) → edge Pallavi → silent
#   English:  kokoro (af_heart) → edge Neerja → silent
# Other options: pocket_tts, kokoro, edge, indic_parler, bodhan (paid), gemini (paid), silent
TTS_PROVIDER=local
TTS_TANGLISH_PROVIDER=pocket_tts
TTS_ENGLISH_PROVIDER=kokoro
TTS_TANGLISH_VOICE=geetha
# af_heart | af_bella | bf_emma
TTS_ENGLISH_VOICE=af_heart
# auto | tanglish | english
TTS_DEFAULT_LANG=auto
# wav | mp3 (mp3 needs ffmpeg)
TTS_OUTPUT_FORMAT=wav
TTS_SENTENCE_PAUSE_MS=350
TTS_COMMA_PAUSE_MS=180
# LLM transliteration for words missing from the lexicon (cached to disk; offline rules otherwise)
TTS_TRANSLIT_LLM=true
KOKORO_MODEL_PATH=.cache/models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=.cache/models/kokoro/voices-v1.0.bin
KOKORO_AUTO_DOWNLOAD=true
POCKET_TTS_VOICE_PROMPT=
# Indic Parler-TTS (only with TTS_PROVIDER=indic_parler; gated model needs an HF token)

# --- Speech-to-Text ---
# Local Faster-Whisper: auto = large-v3-turbo on CUDA (int8_float16), else small int8 CPU
FASTER_WHISPER_MODEL=auto
FASTER_WHISPER_CPU_MODEL=small
FASTER_WHISPER_DEVICE=auto
# Groq Whisper (cloud alternative)
BOOKEY_STT_MODEL=whisper-large-v3-turbo
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Bodhan Indic-Speak Text-to-Speech (paid, opt-in) ---
BODHAN_API_KEY=
BODHAN_TTS_MODEL=indic-speak
BODHAN_TTS_VOICE=Anitha
BODHAN_TTS_LANG=ta
BODHAN_TTS_STYLE="educational lecture"

# --- Gemini Text-to-Speech (paid, opt-in) ---
BOOKEY_TTS_MODEL=gemini-3.8-flash-tts
BOOKEY_TTS_VOICE=Puck
BOOKEY_TTS_STYLE="clear, warm, patient teaching style"
# --- Edge TTS (free online fallback, FEMALE) ---
EDGE_TTS_VOICE=ta-IN-PallaviNeural
EDGE_TTS_VOICE_EN=en-IN-NeerjaNeural

# --- Audio Cache ---
AUDIO_CACHE_DIR=./backend/.cache/bookey-voice
VOICE_ENABLED=true
TTS_FIRST_SENTENCE_ONLY=true


# =============================================================================
# Course builder: YouTube
# =============================================================================
# Pinned analyzer package (npx). yt-dlp/npx run with a minimal environment: only
# PATH/system vars and YT_DLP_COOKIE*/YTDLP_COOKIE* are passed — never app secrets.
COURSE_BUILDER_VIDEO_ANALYZER_PKG=mcp-video-analyzer@0.11.0
